    "deny_private_networks": true
  },
  "process": {
    "allowed_commands": ["python"]
  },
  "gateway": {
    "host": "127.0.0.1",
    "port": 8766
  },
  "audit": {
    "path": ".agentsecure/smoke-audit.log"
  }
}
