{
  "secrets": [
    {
      "env_name": "OPENAI_API_KEY",
      "virtual_token": "virt_openai_smoke_0000000000000001",
      "real_secret_env": "AGENTSECURE_REAL_OPENAI_API_KEY",
      "inject_as": "authorization_bearer",
      "provider": "openai"
    }
  ],
  "network": {
    "allow_domains": ["example.com"],
